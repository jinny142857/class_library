{
  "name": "class-library",
  "version": "1.0.0",
  "description": "양배추 책방 - 초등 학급문고 대출·반납·예약 웹앱 (neon-vercel-migration 브랜치: Postgres(Neon) + Vercel용)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"console.log('빌드 단계 없음: 번들러/트랜스파일 없는 순수 JS + 정적 파일 그대로 배포')\"",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server.js",
    "test": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neondatabase/serverless": "^0.10.4"
  }
}
